# Backend local development. Never commit the real .env file.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-new-unique-password-at-least-12-chars
TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_ORIGINS=http://localhost:5173

# Local video and subtitle/audio files are saved below backend-python/storage/.
VIDEO_STORAGE_DRIVER=local
VIDEO_STORAGE_DIR=storage
MAX_VIDEO_UPLOAD_MB=3900

# Optional PostgreSQL pool tuning.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Set VIDEO_STORAGE_DRIVER=supabase for a durable remote object-storage target.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=keep-this-private
# SUPABASE_PUBLISHABLE_KEY=public-project-key
# SUPABASE_VIDEO_BUCKET=aimefilms-videos
# TMDB_API_KEY=optional-private-tmdb-key
