# Copy to .env for local development. Keep real credentials out of Git.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-new-unique-password-at-least-12-chars
TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_ORIGINS=http://localhost:5173
