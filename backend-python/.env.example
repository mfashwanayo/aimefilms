# AimeFilms backend configuration
# Set DATABASE_URL to the Supabase PostgreSQL connection string for production.
DATABASE_URL=
# SQLite is used only when DATABASE_URL is empty (local development).
DB_PATH=../backend-data/aimefilms.sqlite
ADMIN_NAME=your-admin-name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-new-unique-password
TOKEN_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
